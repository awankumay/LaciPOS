{
  "permissions": {
    "defaultMode": "auto"
  },
  "enabledMcpjsonServers": [
    "laravel-boost",
    "laraplugins-package-search"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-bootstrap.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive-artisan.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-bootstrap.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "attribution": {
    "commit": "Co-Authored-By: SupportAgent <support@mitracoretech.id>",
    "pr": ""
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "laravel-boost@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "antislop@anti-slop": true,
    "ponytail@ponytail": true
  },
  "language": "Indonesian"
}
